{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shhield-downloads",
  "account_id": "3e87efa04e6357d6f423001eb9c69798",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-06",
  "workers_dev": true,
  "routes": [
    { "pattern": "download.shhield.ai/stable/*", "zone_name": "shhield.ai" },
    { "pattern": "download.shhield.ai/staging/*", "zone_name": "shhield.ai" },
    { "pattern": "download.shhield.ai/releases/*", "zone_name": "shhield.ai" }
  ],
  "r2_buckets": [
    { "binding": "RELEASES", "bucket_name": "shhield-releases" }
  ]
}
